OPENAI_API_KEY=sk-...

# Comma-separated list of valid API keys for the /v1/query* endpoints
# (X-API-Key header). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=dev-key-change-me

# Requests per minute, per API key, before /v1/query* returns 429.
RATE_LIMIT_PER_MINUTE=30

# Comma-separated browser origins allowed to call the API cross-origin (CORS).
# Leave unset/empty to block all browser cross-origin calls by default —
# server-to-server callers (curl, backend services) are unaffected either way.
CORS_ALLOWED_ORIGINS=
